# Copy to .env.local and fill in. These stay SERVER-SIDE (except the two NEXT_PUBLIC_ ones).
# Never commit .env.local. Never expose OPENAI_API_KEY or the SECRET key to the client.

OPENAI_API_KEY=

# Supabase (new-format keys: sb_publishable_... / sb_secret_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin panel (/admin): demo-grade password gate. REQUIRED in production -
# if unset in a production build, /admin is locked (fail-closed). In local dev,
# leaving it empty opens the panel (with a visible "unprotected" banner).
# Log in at /admin?key=YOUR_PASSWORD or via the prompt.
ADMIN_PASSWORD=
